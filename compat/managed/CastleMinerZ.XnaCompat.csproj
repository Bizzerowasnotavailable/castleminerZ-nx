<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>CastleMinerZ.XnaCompat</AssemblyName>
    <RootNamespace>CastleMinerZ.XnaCompat</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="FNA">
      <HintPath>$(FnaPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateFnaPath" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(FnaPath)')"
           Text="Set FnaPath to the pinned FNA.dll build." />
  </Target>
</Project>
