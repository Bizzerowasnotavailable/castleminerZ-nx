<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>program</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="libnx" />
    <Reference Include="FNA">
      <HintPath>$(FnaPath)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="CastleMinerZ.XnaCompat">
      <HintPath>$(CompatPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateXnaProbePaths" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(FnaPath)')"
           Text="Set FnaPath to the pinned FNA.dll build." />
    <Error Condition="!Exists('$(CompatPath)')"
           Text="Set CompatPath to the CastleMinerZ.XnaCompat.dll build." />
  </Target>
</Project>
