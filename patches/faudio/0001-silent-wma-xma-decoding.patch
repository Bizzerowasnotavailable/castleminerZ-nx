diff --git a/src/FAudio_silent_wmadec.c b/src/FAudio_silent_wmadec.c
new file mode 100644
index 0000000..d2d4cc9
--- /dev/null
+++ b/src/FAudio_silent_wmadec.c
@@ -0,0 +1,77 @@
+/* FAudio WMADEC stand-in that plays xWMA and XMA2 voices as timed silence.
+ *
+ * Without a decoder backend, FAudio_CreateSourceVoice leaves xWMA and XMA2
+ * voices with no decode function, and the mixer calls that null pointer as
+ * soon as such a voice plays. XACT wave banks commonly contain xWMA.
+ *
+ * Building with SILENT_WMA_DECODING enables the HAVE_WMADEC bookkeeping with
+ * this backend instead. Buffer lengths then come from the xWMA packet table
+ * or the XMA2 sample count, so these voices keep their real duration, loop
+ * and end on time, and the mixer receives silence. Nothing is decoded.
+ */
+
+#include "FAudio_internal.h"
+
+#ifdef FAUDIO_SILENT_WMADEC
+
+/* Stateless: every silent voice points at this one marker object. */
+struct FAudioWMADEC
+{
+	uint8_t unused;
+};
+
+static struct FAudioWMADEC silent_wmadec;
+static uint8_t silent_wmadec_reported;
+
+uint32_t FAudio_WMADEC_init(FAudioSourceVoice *voice, uint32_t type)
+{
+	LOG_FUNC_ENTER(voice->audio)
+
+	if (!silent_wmadec_reported)
+	{
+		char message[128];
+		FAudio_snprintf(
+			message,
+			sizeof(message),
+			"FAudio: format 0x%X has no decoder in this build; it plays as silence",
+			(unsigned int) type
+		);
+		FAudio_Log(message);
+		silent_wmadec_reported = 1;
+	}
+
+	voice->src.wmadec = &silent_wmadec;
+	voice->src.decode = NULL;
+
+	LOG_FUNC_EXIT(voice->audio)
+	return 0;
+}
+
+void FAudio_WMADEC_free(FAudioSourceVoice *voice)
+{
+	LOG_FUNC_ENTER(voice->audio)
+	voice->src.wmadec = NULL;
+	voice->src.decode = NULL;
+	LOG_FUNC_EXIT(voice->audio)
+}
+
+void FAudio_WMADEC_end_buffer(FAudioSourceVoice *voice)
+{
+	/* There is no decoder state to reset between buffers. */
+	(void) voice;
+}
+
+void decode_wma(
+	FAudioVoice *voice,
+	struct queued_buffer *buffer,
+	float *dst,
+	uint32_t sample_count
+) {
+	(void) buffer;
+	FAudio_zero(
+		dst,
+		sample_count * voice->src.format->nChannels * sizeof(float)
+	);
+}
+
+#endif /* FAUDIO_SILENT_WMADEC */
