<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil">
      <HintPath>$(MonoCecilPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateMonoCecilPath" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(MonoCecilPath)')"
           Text="Set MonoCecilPath to the pinned Mono.Cecil.dll build." />
  </Target>
</Project>
